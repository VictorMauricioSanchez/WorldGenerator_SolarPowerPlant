<?xml version="1.0"?>

<sdf version="1.9">
    <world name="mundo_prueba">

        <!-- Sistemas básicos de Gazebo -->
        <plugin
            filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>

        <plugin
            filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

        <plugin
            filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

        <!-- Luz principal -->
        <light type="directional" name="sol">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <!-- Suelo -->
        <model name="suelo">
            <static>true</static>

            <link name="link">

                <collision name="collision">
                    <geometry>
                        <box>
                            <size>20 20 0.1</size>
                        </box>
                    </geometry>
                </collision>

                <visual name="visual">
                    <geometry>
                        <box>
                            <size>20 20 0.1</size>
                        </box>
                    </geometry>

                    <material>
                        <ambient>0.25 0.25 0.25 1</ambient>
                        <diffuse>0.45 0.45 0.45 1</diffuse>
                    </material>
                </visual>

            </link>
        </model>

        <!-- Cubo de prueba -->
        <model name="cubo_prueba">
            <pose>0 0 0.55 0 0 0</pose>

            <link name="link">

                <collision name="collision">
                    <geometry>
                        <box>
                            <size>1 1 1</size>
                        </box>
                    </geometry>
                </collision>

                <visual name="visual">
                    <geometry>
                        <box>
                            <size>1 1 1</size>
                        </box>
                    </geometry>

                    <material>
                        <ambient>0.8 0.1 0.1 1</ambient>
                        <diffuse>0.8 0.1 0.1 1</diffuse>
                    </material>
                </visual>

            </link>
        </model>

    </world>
</sdf>
